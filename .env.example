# Copy this file to .env and adjust the values.
# Every variable is validated on startup; the server refuses to start if one is invalid.

# development | production | test
NODE_ENV=development
# 1-65535
PORT=3000
# Path relative to the project root, or :memory: for a throwaway database
DB_FILE=data/radiocalico.db
# http(s) URL of the HLS playlist
STREAM_URL=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8

# Secure cookies require HTTPS; defaults to true when NODE_ENV=production
# COOKIE_SECURE=false

# Set when running behind a reverse proxy so the real client IP is used for rate limiting:
# true | false | hop count (e.g. 1) | comma-separated IPs/subnets/loopback/linklocal/uniquelocal
# TRUST_PROXY=false

# Vote rate limit per client IP: RATE_LIMIT_MAX votes per RATE_LIMIT_WINDOW_MS
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=20
